APP_NAME=LexSched
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Office details shown on pages and messages
OFFICE_NAME="Dela Cruz, Santos & Villanueva Law Offices"
OFFICE_ADDRESS="2/F Rizal Building, Gen. Luna St., Dipolog City"
OFFICE_PHONE="(065) 212-3456"
GCASH_NUMBER="0917 555 0142"
MAYA_NUMBER="0918 555 0142"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite works with no setup. For XAMPP/MySQL, comment out the SQLite line and fill in the MySQL lines.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lexsched
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Manila

# SMS via Semaphore (https://semaphore.co). Leave the key empty to only log SMS messages.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=LEXSCHED

# PayMongo (https://dashboard.paymongo.com/developers). Use sk_test_ keys while testing.
# Register the webhook with: php artisan paymongo:webhook https://your-domain/webhooks/paymongo
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
